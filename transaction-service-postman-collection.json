              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/v1/transactions", "host": ["{{baseUrl}}"], "path": ["v1", "transactions"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"{{accountId}}\",\n  \"entryType\": \"DEBIT\",\n  \"amount\": 25.50,\n  \"currency\": \"USD\",\n  \"transactionDate\": \"2026-05-23\",\n  \"reference\": \"INV-001\",\n  \"description\": \"Lunch\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', function () { pm.response.to.have.status(201); });",
                  "var body = pm.response.json();",
                  "pm.expect(body.success).to.eql(true);",
                  "pm.expect(body.data.transactionId).to.be.a('string');",
