            "url": { "raw": "{{baseUrl}}/v1/categories/{{categoryId}}", "host": ["{{baseUrl}}"], "path": ["v1", "categories", "{{categoryId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 204', function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Category - Non-Existent (404)",
          "request": {
            "method": "DELETE",
            "header": [ { "key": "X-User-Id", "value": "{{userId}}" } ],
            "url": {
              "raw": "{{baseUrl}}/v1/categories/00000000-0000-0000-0000-deadbeef0000",
              "host": ["{{baseUrl}}"], "path": ["v1", "categories", "00000000-0000-0000-0000-deadbeef0000"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 404', function () { pm.response.to.have.status(404); });",
                  "pm.expect(pm.response.json().error.code).to.eql('CATEGORY_NOT_FOUND');"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
